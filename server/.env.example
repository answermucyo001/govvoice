# CFCS Rwanda - Environment Configuration
# Copy this file to .env and fill in the values.

# ===== Core =====
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# ===== Database (MySQL 8) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=cfcs
DB_PASSWORD=cfcs_dev_password
DB_NAME=cfcs
# Managed MySQL providers usually require TLS
DATABASE_SSL=false

# ===== Authentication =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12
# 32+ random characters. Encrypts national ID numbers at rest (AES-256-GCM).
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# ===== Cookies =====
# lax for same-site local development, none for cross-site production (requires HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_NAME=cfcs_refresh

# ===== Uploads =====
# STORAGE_PROVIDER=cloudinary | s3 | local (local is development-only)
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_FILES=5
MAX_UPLOAD_SIZE_BYTES=5242880

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cfcs

# AWS S3 (alternative to Cloudinary)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ===== SMS (Africa's Talking or Twilio) =====
# SMS_PROVIDER=africastalking | twilio | console
SMS_PROVIDER=console
SMS_SENDER_ID=CFCS
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Jobs =====
ESCALATION_CRON=*/15 * * * *
ENABLE_ESCALATION_JOB=true

# ===== Seed data =====
SUPER_ADMIN_EMAIL=admin@govvoice.rw
SUPER_ADMIN_PHONE=+250788000000
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NATIONAL_ID=1198000000000001
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
# Adds a demo citizen (citizen@example.rw / Citizen123!) and sample submissions
SEED_DEMO=false

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
SUBMIT_RATE_LIMIT_MAX=20

# ===== Single-service deployment =====
# Set to true to serve client/dist from the API process (Docker/Render/Railway).
SERVE_CLIENT=false
CLIENT_DIST_PATH=../client/dist
